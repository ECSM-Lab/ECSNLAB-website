@techreport{Feijoo2026BuildingResilientEnergyPolicies,
  author      = {Feijoo, Felipe and Kundu, Abhishake and Flores, Francisco and Paredes, Paola and Soto Morales, Ignacio and Villanueva Garc{\'i}a, Isabella},
  title       = {{Building Resilient Energy Policies in Asia-Pacific}},
  institution = {Asia-Pacific Economic Cooperation Secretariat},
  type        = {Technical Report},
  address     = {Singapore},
  year        = {2026},
  number      = {APEC\#226-RE-01.2},
  abstract    = {This report examines how selected APEC economies are incorporating energy resilience into policy, planning, regulation, and investment frameworks. Building on the APEC Energy Resiliency Principles and concepts from the IPCC, IEA, CDRI, and CIGRE, it defines resilience as the capacity of energy systems to anticipate shocks, withstand and limit impacts, and recover in ways that reduce future vulnerability. The assessment compares economy-level approaches across dimensions such as infrastructure robustness, flexibility and adaptability, recovery capacity, governance, reliability metrics, and climate and disaster risk integration. The report finds that resilience and decarbonization should be planned together, supported by climate-informed infrastructure planning, diversified energy systems, storage, grid modernization, distributed resources, stronger recovery metrics, and coordinated governance across energy and other critical infrastructure sectors.},
  keywords    = {Energy resilience, Energy policy, climate adaptation, Infrastructure planning, Governance},
  url         = {https://www.apec.org/publications/2026/04/building-resilient-energy-policies-in-asia-pacific}
}

@techreport{Feijoo2026HydrogenCertificationAPEC,
  author      = {Feijoo, Felipe and Kundu, Abhishake and Flores, Francisco and Baeriswyl Concha, Adelaida and Soto Morales, Ignacio and Villanueva Garc{\'i}a, Isabella},
  title       = {{Certification of Hydrogen and Its Derivatives in APEC Economies: Its Role in Driving the Market}},
  institution = {Asia-Pacific Economic Cooperation Secretariat},
  type        = {Technical Report},
  address     = {Singapore},
  year        = {2026},
  number      = {APEC\#226-RE-01.1},
  abstract    = {This report examines the role of certification frameworks for hydrogen and its derivatives in supporting market development across APEC economies. It reviews economy-level hydrogen policies and regulations, as well as survey-based evidence on readiness, barriers, and opportunities for harmonization. The report highlights that hydrogen certification is becoming increasingly important for verifying emissions reductions, strengthening trust, attracting investment, and enabling international trade. It identifies shared challenges, including emissions tracking, high infrastructure costs, limited technical expertise, and the need to incorporate broader sustainability attributes such as water use, land stewardship, social impacts, and labor criteria. The report concludes that coordinated policy action, technical standard alignment, cross-border collaboration, chain-of-custody tools, financial incentives, and capacity building can help APEC economies accelerate certified hydrogen deployment and strengthen their role in the clean energy transition.},
  keywords    = {Hydrogen certification, Certification schemes, Life-cycle assessment, Energy transition, Decarbonization, International trade},
  url         = {https://www.apec.org/publications/2026/01/certification-of-hydrogen-and-its-derivatives-in-apec-economies--its-role-in-driving-the-market}
}

@techreport{Vergara2025Chile2050,
  author      = {Vergara, Walter and Spiegel, Jon and Feijoo, Felipe},
  title       = {{Chile 2050: Roadmap to a Fossil-Fuel Free, Electricity-Driven, Prosperous Economy}},
  institution = {The Climate Institute},
  type        = {Climate Institute Study},
  address     = {Washington, DC},
  year        = {2025},
  isbn        = {979-8-218-79547-4},
  abstract    = {This report evaluates a pathway for Chile to become a fossil-fuel-free, fully electrified economy by 2050. It compares the current carbon-neutrality vision with a zero-emissions scenario based on renewable electricity, storage, transmission expansion, electrified transport, industrial electrification, green hydrogen, and building-sector electrification. The analysis estimates levelized costs, infrastructure requirements, stranded assets, health benefits, energy-efficiency gains, job creation, capital needs, and policy barriers. Overall, the report argues that Chile's renewable resource potential and institutional capacity could make full electrification economically attractive while supporting innovation, employment, and long-term prosperity.},
  keywords    = {Electrification, Fossil-fuel-free economy, Decarbonization, zero emissions, energy transition, Climate policy},
  url = {https://climate.org/wp-content/uploads/2025/09/Final-Chile-Report.pdf}
  }

@techreport{SaavedraDote2024ElectromobilityFlexibilitySEN,
  author      = {Saavedra Dote, Iv{\'a}n and Oviedo Carrasco, Ximena and Dazarola Leichtle, Fernando and Feijoo, Felipe and Bustos Bustos, Nicol{\'a}s and Letelier G{\'a}lvez, Cristi{\'a}n and V{\'e}liz Rojas, Karina and Villegas Rivera, Valentina},
  title       = {{Electromobility and Its Contribution to Flexibility in the Chilean National Power System: Next Steps} ({Electromovilidad y su aporte a la flexibilidad en el Sistema El{\'e}ctrico Nacional: Pr{\'o}ximos pasos})},
  institution = {Agencia de Sostenibilidad Energ{\'e}tica},
  type        = {Technical Report},
  address     = {Chile},
  year        = {2024},
  abstract    = {This report presents the results of a study that quantifies the impacts of electromobility on the Chilean power system and assesses the cost-benefit performance of flexibility strategies for electric vehicles. The study analyzes electromobility as a distributed energy resource through a literature review, regulatory analysis, interviews, participatory workshops, and modeling with EnergyPLAN and optimization tools. Three charging modes are compared: dumb charging, smart charging, and vehicle-to-grid. The results show that smart charging and V2G can reduce operating costs, improve the integration of renewable energy, and provide flexibility to the power system, although they also require additional investments in distribution and transmission infrastructure. The report proposes a set of regulatory, institutional, technological, and market actions to enable the contribution of electromobility flexibility in Chile.},
  keywords    = {Electromobility, Chilean National Power System, Renewable energy, Decarbonization, Energy regulation},
  note        = {Original Spanish title: Electromovilidad y su aporte a la flexibilidad en el Sistema El{\'e}ctrico Nacional: Pr{\'o}ximos pasos. Developed by IESD and Plataforma P{\'u}blica, with review by the Agencia de Sostenibilidad Energ{\'e}tica and the Ministry of Energy of Chile. GEF7 Electromobility Project: Accelerating the adoption of electric mobility in Chile.}
}

  @techreport{KintnerMeyer2022NetZeroWorldFiveCountries,
  author      = {Kintner-Meyer, Michael and Conzelmann, Guenter and Kim, Hyekyung Clarisse and Zhou, Nan and DeStephano, Paelina and Durga, Siddarth and Elgowainy, Amgad and Hamilton, Bruce and Kanudia, Amit and Khanna, Nina and Khan, Zarrar and Kyle, Page and Letschert, Virginie and Feng, Wei and Feijoo, Felipe and Flores, Francisco and Giannakidis, George and Licandeo, Francisca and McJeon, Haewon and Reber, Timothy and Rough, Daniella and Westphal, Michael and Wright, Evelyn},
  title       = {{Preliminary Analysis of Decarbonization Pathways for Five Countries: The Net Zero World Initiative Report Series -- 01}},
  institution = {Pacific Northwest National Laboratory},
  type        = {Technical Report},
  address     = {Richland, WA},
  year        = {2022},
  number      = {PNNL-33619},
  abstract    = {This report presents preliminary Phase I modeling results from the Net Zero World Initiative for five partner countries: Argentina, Chile, Egypt, Indonesia, and Nigeria. The initiative mobilizes U.S. government agencies, national laboratories, philanthropies, and country partners to co-create technical and investment pathways for accelerating global energy system decarbonization. The analysis uses country-specific modeling approaches to explore high-level decarbonization opportunities and inform future Phase II work. Across countries, the report identifies four major mechanisms for emissions reductions: end-use energy efficiency improvements, fuel switching to clean energy carriers such as electricity and hydrogen, decarbonization of electricity supply through large-scale renewable energy deployment, and carbon capture and storage for remaining fossil-based systems. The findings are preliminary and indicative, intended to support further consultation, more detailed sectoral analysis, and investment-oriented pathway design.},
  keywords    = {Net Zero World Initiative, Decarbonization pathways, Net zero, energy systems, Climate policy, Energy transition},
  url         = {https://www.pnnl.gov/main/publications/external/technical_reports/PNNL-33619.pdf},
}


@techreport{PalmaBehnke2021ChileanRenewableEnergyExports,
  author      = {Palma-Behnke, Rodrigo and Abarca del R{\'i}o, Rodrigo and Agostini, Claudio and Alvear, Carlos and Amaya, Jorge and Araya, Paz and Arellano, Nelson and Arriagada, Pedro and Avil{\'e}s, Camilo and Barr{\'i}a, Carlos and Berg, Alex and Buchuk, Daniela and Cardemil, Jos{\'e} Miguel and Dall'Orso, Francisco and Dom{\'i}nguez, Mar{\'i}a Paz and Escauriaza, Cristian and Feijoo, Felipe and others},
  title       = {{The Chilean Potential for Exporting Renewable Energy}},
  institution = {Comit{\'e} Cient{\'i}fico de Cambio Clim{\'a}tico and Ministerio de Ciencia, Tecnolog{\'i}a, Conocimiento e Innovaci{\'o}n},
  type        = {Mitigation and Energy Working Group Report},
  address     = {Santiago, Chile},
  year        = {2021},
  abstract    = {This report synthesizes scientific evidence on Chile's potential to export renewable energy and the opportunities and challenges this could create for the country's carbon neutrality goals. Based on a collaborative interdisciplinary process involving 71 researchers and specialists, the report identifies four main export pathways: renewable electricity through transmission grids, hydrogen and derivatives through pipelines or maritime transport, products and services manufactured locally using renewable energy, and knowledge and research and development capabilities. The report emphasizes that renewable energy exports should be consistent with Chile's climate policy framework, including its NDC, future Framework Law on Climate Change, Long-Term Climate Strategy, and energy sector mitigation and adaptation plans. It also highlights the need to address social, environmental, technological, economic, institutional, scientific, and political dimensions to ensure that export strategies support sustainable development, legitimacy, and climate justice.},
  keywords    = {Renewable energy exports, Sustainable development, Climate policy, Energy transition, Export potential,},
  url = {https://minciencia.gob.cl/uploads/filer_public/c4/e1/c4e187c3-9545-481c-bc12-8a75a20b83d7/the_chilean_potential_for_exporting_renewable_energy.pdf}
  }







