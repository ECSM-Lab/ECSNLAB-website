<a href="#top" class="to-top" id="to-top" aria-label="Back to top">↑</a>

<script src="assets/js/main.js?v=20260427c"></script>
<script src="assets/js/renderers.js?v=20260427c"></script>
<script src="assets/js/bibtex.js?v=20260427c"></script>
<script src="assets/js/renderers.js?v=20260427c"></script>
<script>
(function () {
  if (typeof ECSRender === 'undefined') {
    var html = '<p style="color:#c53030;padding:14px;border-left:3px solid #c53030;background:#fff5f5">' +
      '<strong>renderers.js failed to load.</strong> Hard-refresh with Ctrl+Shift+R, or open ' +
      '<a href="diagnose.html">diagnose.html</a>.</p>';
    var ids = ['stats-strip','leadership','home-research-areas','home-projects','selected-papers','home-news'];
    ids.forEach(function (id) { var el = document.getElementById(id); if (el) el.innerHTML = html; });
    return;
  }
  try {
    ECSRender.stats('#stats-strip');
    ECSRender.leadership('#leadership');
    ECSRender.researchAreas('#home-research-areas', 6);
    ECSRender.projects('#home-projects', { featured: 3 });
    ECSRender.selectedPapers('#selected-papers');
    ECSRender.news('#home-news', 4);
  } catch (e) {
    console.error('[ECS home] render error:', e);
    var el = document.getElementById('leadership');
    if (el) el.innerHTML = '<p style="color:#c53030">Render error: ' + e.message + '</p>';
  }
})();
</script>
</body>
</html>
